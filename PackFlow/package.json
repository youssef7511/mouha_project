{
  "name": "packflow",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "Offline PackFlow desktop application",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:prototype": "cd prototype && node tests/finance.test.cjs",
    "test:core": "docker compose run --rm core-test",
    "test:browser": "playwright test",
    "check:native": "docker compose --profile test run --build --rm native-check",
    "format": "prettier --write src tests/browser vite.config.ts vitest.config.ts playwright.config.ts",
    "format:check": "prettier --check src tests/browser vite.config.ts vitest.config.ts playwright.config.ts",
    "dev:core": "docker compose up -d core",
    "seed:demo": "node scripts/seed-demo.mjs",
    "tauri": "tauri",
    "preview:prototype": "python -m http.server 8080 --bind 127.0.0.1 --directory prototype/dist"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.104.2",
    "@tauri-apps/api": "2.12.3",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.90.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.2",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
